# Copy to .env (gitignored) and fill in. Never commit real values.
# Generate secrets with: openssl rand -hex 32

# --- docker compose ---
# Required by docker compose. Hex values are safe to embed in the DATABASE_URL.
POSTGRES_PASSWORD=
# POSTGRES_USER=postgres
# Bind address for the published service port (default 127.0.0.1, loopback only).
# SERVICE_HOST=127.0.0.1
# SERVICE_PORT=3000

# --- service ---
DATABASE_URL=postgres://postgres@localhost:5432/usage_metering
PORT=3000
# Required to call POST /accounts. Required (and must not be dev-admin-key) when
# NODE_ENV=production, which the Docker image sets.
ADMIN_API_KEY=
# PostgreSQL connections per service process.
DB_POOL_SIZE=10

# --- AI agent (npm run agent) ---
ANTHROPIC_API_KEY=
SERVICE_URL=http://localhost:3000
# An account API key to reuse; when empty the agent creates a demo account with ADMIN_API_KEY.
METERING_API_KEY=
AGENT_USER_ID=reader-1
