DATABASE_URL=postgres://postgres@localhost:5432/usage_metering
PORT=3000
# Required to call POST /accounts. Use a long random value outside local dev.
ADMIN_API_KEY=dev-admin-key
# PostgreSQL connections per service process.
DB_POOL_SIZE=10

# AI agent (npm run agent)
ANTHROPIC_API_KEY=
SERVICE_URL=http://localhost:3000
# An account API key to reuse; when empty the agent creates a demo account with ADMIN_API_KEY.
METERING_API_KEY=
AGENT_USER_ID=reader-1
