{
  "name": "usage-metering-service",
  "version": "1.0.0",
  "description": "Usage metering and quota service: accounts, users, plans, idempotent consume, history",
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/migrate.ts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "demo": "tsx client/demo.ts",
    "agent": "tsx agent/main.ts",
    "loadtest": "tsx loadtest/run.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Baraa-Rj/usage-metering-service.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Baraa-Rj/usage-metering-service/issues"
  },
  "homepage": "https://github.com/Baraa-Rj/usage-metering-service#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
